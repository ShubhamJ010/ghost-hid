# Build outputs
build/
bin/
gen/
*.apk
*.aab
*.zip

# Android / Gradle artifacts
.gradle/
app/build/
local.properties
.kotlin/

# Signing keys & properties
*.jks
*.keystore
keystore.properties
# The Android debug key is tracked on purpose: CI builds debug APKs with it so
# every PR artifact keeps the same signature, and it is not a secret key.
!debug.keystore

# Logs & temp files
*.log
*.tmp
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# IDE & editor files
.idea/
*.iml
captures/
.vscode/
